; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Quack Cook"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.025, 0.025, 0.025, 1)
boot_splash/image="res://assets/textures/ui/boot_splash.png"
config/icon="res://assets/textures/ui/icon.svg"

[autoload]

SceneTransition="*res://scenes/ui/scene_transition.tscn"
AppSettings="*res://scripts/managers/app_settings.gd"
AudioManager="*res://scenes/audio/audio_manager.tscn"
QueueManager="*res://scripts/managers/queue_manager.gd"
GameManager="*res://scripts/managers/game_manager.gd"

[display]

window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[global_group]

Player=""
Pickable=""
Interactable=""
Focusable=""
Fryable=""
Cuttable=""
Trash=""
Boilable=""

[gui]

theme/custom_font="res://assets/font/TitanOne-Regular.ttf"

